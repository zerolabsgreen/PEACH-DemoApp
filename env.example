# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase publishable key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Your Supabase secret key (keep this secret, server-side only!)
SUPABASE_SECRET_KEY=your-secret-key-here

# Optional: Local development overrides
# Uncomment these if you want to use local Supabase for development
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
